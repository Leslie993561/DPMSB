# Chave da API da Anthropic, usada apenas no servidor (nunca exposta ao navegador).
# Obtenha em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Banco de dados (Postgres/Supabase) — obrigatório, inclusive em dev local.
# No painel do Supabase: Project Settings > Database > Connection string
# (modo "Transaction" ou "Session"; use a porta 5432 ou 6543 conforme indicado).
DATABASE_URL=postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave para assinar o cookie de sessão do login — obrigatória. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# E-mails com acesso de administrador (gerenciam gestores/permissões e veem
# o portal inteiro, sem depender da tabela gestores_acesso). Separados por vírgula.
ADMIN_EMAILS=admin@empresa.com

# Supabase Storage — documentos de colaborador e PDF anexado à ficha de EPI
# (bucket PRIVADO, ex.: "documentos-privados"). Sem isso o portal funciona
# normalmente, só não deixa anexar/baixar arquivo.
# No painel do Supabase: Project Settings > API > Project URL / service_role key.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documentos-privados

# Só para o upload de PDF grande dos Programas SST (PCMSO/LTCAT/PGR): o
# navegador sobe o arquivo direto no Supabase, sem passar pelo corpo da
# requisição do Next.js (a Vercel recusa acima de ~4,5MB nas Serverless
# Functions). Os dois valores são PÚBLICOS por design do Supabase — mesma URL
# de cima e a chave "anon" (não a service_role) em Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
